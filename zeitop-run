#!/bin/sh
# Steam options: /absolute/path/zeitop-run %command%
# Non-Steam: /absolute/path/zeitop-run /path/to/game [args...]
set -eu
ROOT=$(CDPATH= cd "$(dirname "$0")" && pwd)
LAYER_DIR="$ROOT/runtime/vulkan"
VULKAN_64="$LAYER_DIR/libzeitop-vulkan.so"
VULKAN_32="$LAYER_DIR/libzeitop-vulkan32.so"
GL_HOOK="$ROOT/runtime/libzeitop-gl.so"
if [ "$#" -eq 0 ]; then
  printf 'Usage: %s /path/to/game [arguments...]\nSteam: %s %%command%%\n' "$0" "$0" >&2
  exit 2
fi
# Explicit opt-in for *experimental* stage 2; normal launches remain unchanged.
if [ "${ZEITOP_VULKAN_STAGE2:-0}" = "1" ]; then
  LAYER_DIR="$ROOT/runtime/stage2"
  VULKAN_64="$LAYER_DIR/libzeitop-stage2.so"
  VULKAN_32="$LAYER_DIR/libzeitop-stage2-32.so"
fi
if [ ! -f "$VULKAN_64" ] ||
   [ ! -f "$VULKAN_32" ] ||
   [ ! -f "$ROOT/runtime/libzeitop-gl32.so" ] ||
   [ ! -f "$GL_HOOK" ]; then
  printf '%s\n' "Zeitop: components missing. Run ./run.sh once to build them." >&2
  exit 1
fi
# For directly launched ELF32 programs, preload the matching GL shim.
# Steam/Proton child processes inherit the architecture-filtered Vulkan layers.
TARGET=$1
case "$TARGET" in
  */*) ;;
  *) TARGET=$(command -v "$TARGET" 2>/dev/null || printf "%s" "$TARGET") ;;
esac
DIRECT_ELF32=0
if [ -f "$TARGET" ] && command -v file >/dev/null 2>&1 &&
   file -Lb -- "$TARGET" | grep -q "ELF 32-bit"; then
  GL_HOOK="$ROOT/runtime/libzeitop-gl32.so"
  DIRECT_ELF32=1
fi
# A generated *per-launch* TOML keeps the user's canonical lsfg-vk file
# untouched and prevents one game's FG handshake from affecting another.
# With FG requested OFF, start the selected profile in its real multiplier
# and block the first app present inside Zeitop's Vulkan layer. The gate
# switches this session to 1x before releasing that present; future GUI
# toggles hot-reload the same private file.
FG_READY=0
# The installed external lsfg-vk x86 layer fails Vulkan enumeration on
# this host, so known direct 32-bit binaries safely use pacing only.
if [ "${ZEITOP_VULKAN_STAGE2:-0}" != "1" ] && [ "$DIRECT_ELF32" != "1" ]; then
  if FG_SESSION_OUTPUT=$(python3 -B "$ROOT/fg_live.py" session "$ROOT" "$$"); then
    FG_READY=1
    FG_SESSION_CONFIG=$(printf '%s\n' "$FG_SESSION_OUTPUT" | sed -n '1p')
    FG_PROFILE=$(printf '%s\n' "$FG_SESSION_OUTPUT" | sed -n '2p')
    FG_PENDING=$(printf '%s\n' "$FG_SESSION_OUTPUT" | sed -n '3p')
    export LSFGVK_CONFIG="$FG_SESSION_CONFIG"
    unset DISABLE_LSFGVK
    if [ -z "${LSFGVK_PROFILE:-}" ] && [ -n "$FG_PROFILE" ]; then
      export LSFGVK_PROFILE="$FG_PROFILE"
    fi
    if [ "$FG_PENDING" = "1" ]; then
      ZEITOP_FG_WARMUP_TOKEN=${FG_SESSION_CONFIG##*/}
      export ZEITOP_FG_WARMUP_TOKEN=${ZEITOP_FG_WARMUP_TOKEN%.toml}
    fi
  fi
fi
if [ "$FG_READY" != "1" ]; then
  # Failures, direct ELF32 and stage2 never force an unusable FG layer.
  export DISABLE_LSFGVK=1
  unset ZEITOP_FG_WARMUP_TOKEN
  printf '%s\n' "Zeitop: lsfg-vk session unavailable; only the limiter will load." >&2
fi

# Explicit layer order is application -> Zeitop -> lsfg-vk -> driver.
# Vulkan loader diagnostics list insertion differently, but present tracing
# proved this is the order that paces only the application's real frames.
# Preserve unrelated layers in their inherited relative order.
forced_layers=$(printenv VK_LOADER_LAYERS_ENABLE 2>/dev/null || true)
case "$forced_layers" in
  *LSFGVK*|*lsfgvk*|*LSFG*|*lsfg*)
    printf '%s\n' "Zeitop: remove forced lsfg-vk from VK_LOADER_LAYERS_ENABLE; the launcher manages the layer order." >&2
    exit 2 ;;
esac
inherited_layers=$(printenv VK_INSTANCE_LAYERS 2>/dev/null || true)
remaining_layers=""
old_ifs=$IFS
IFS=:
for layer in $inherited_layers; do
  case "$layer" in
    VK_LAYER_ZEITOP_pacing|VK_LAYER_LSFGVK_frame_generation|"") ;;
    *) remaining_layers="${remaining_layers:+$remaining_layers:}$layer" ;;
  esac
done
IFS=$old_ifs
if [ "$FG_READY" = "1" ]; then
  export VK_INSTANCE_LAYERS="VK_LAYER_ZEITOP_pacing:VK_LAYER_LSFGVK_frame_generation${remaining_layers:+:$remaining_layers}"
else
  export VK_INSTANCE_LAYERS="VK_LAYER_ZEITOP_pacing${remaining_layers:+:$remaining_layers}"
fi
export ZEITOP_HOME="$ROOT"
if [ -n "${VK_LAYER_PATH:-}" ]; then
  export VK_LAYER_PATH="$LAYER_DIR:$VK_LAYER_PATH"
else
  export VK_ADD_LAYER_PATH="$LAYER_DIR${VK_ADD_LAYER_PATH:+:$VK_ADD_LAYER_PATH}"
fi
export LD_PRELOAD="$GL_HOOK${LD_PRELOAD:+:$LD_PRELOAD}"
exec "$@"
